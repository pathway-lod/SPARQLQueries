@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix pmwcat: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/category/> .
@prefix pmwq: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pmwq:PMWQ003 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "PMWQ003" ;
    rdfs:label "Triples per named graph"@en ;
    rdfs:comment "Count triples per named graph in the PlantMetWiki triplestore."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2025-12-18"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:contributor <https://orcid.org/0000-0002-9472-918X> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject pmwcat:Metadata ;
    schema:keywords "metadata" ;
    schema:target <https://plantmetwiki.bioinformatics.nl/sparql> ;
    snorql:alias "1.(Meta)Data/GraphIsLoaded.rq" ;
    prov:wasDerivedFrom <https://github.com/pathway-lod/SPARQLQueries/blob/68fcd95df2f3b86dffc64d962f7d037d6bae6785/1.%28Meta%29Data/GraphIsLoaded.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:select """# Named graphs:
#   graph/pathways              — core WikiPathways RDF (pathways + reactions)
#   graph/gpml-taxonomy-extra   — per-entity species annotations (wp:organism)
#   graph/gpml-properties-extra — PlantCyc key-value properties
#   graph/bgc-mibig             — MIBiG curated biosynthetic gene clusters
#   graph/bgc-plantismash       — plantiSMASH predicted biosynthetic gene clusters
#   graph/ncbitaxon             — NCBITaxon ontology (OBO Foundry, CC0)
#   graph/vocabularies          — pmw:/wp:/gpml: term definitions (self-describing schema)
#   void                        — VoID metadata for all datasets

# Uses VALUES to enumerate only the known PlantMetWiki graphs — fast because
# Virtuoso can use per-graph statistics instead of scanning every triple.
# (A FILTER on ?graph after GRAPH ?g { ?s ?p ?o } forces a full scan of all
# graphs including the 21.7M-triple NCBITaxon graph before filtering.)

SELECT ?graph (COUNT(*) AS ?nTriples)
WHERE {
  VALUES ?graph {
    <http://rdf-plantmetwiki.bioinformatics.nl/graph/pathways>
    <http://rdf-plantmetwiki.bioinformatics.nl/graph/gpml-taxonomy-extra>
    <http://rdf-plantmetwiki.bioinformatics.nl/graph/gpml-properties-extra>
    <http://rdf-plantmetwiki.bioinformatics.nl/graph/bgc-plantismash>
    <http://rdf-plantmetwiki.bioinformatics.nl/graph/bgc-mibig>
    <http://rdf-plantmetwiki.bioinformatics.nl/graph/ncbitaxon>
    <http://rdf-plantmetwiki.bioinformatics.nl/graph/vocabularies>
    <http://rdf-plantmetwiki.bioinformatics.nl/void>
  }
  GRAPH ?graph { ?s ?p ?o . }
}
GROUP BY ?graph
ORDER BY DESC(?nTriples)""" .
