@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix pmwcat: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/category/> .
@prefix pmwq: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pmwq:PMWQ021 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "PMWQ021" ;
    rdfs:label "Proteins of a pathway, with references"@en ;
    rdfs:comment "List all proteins (with labels and publication references) for a given pathway."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-01-27"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:contributor <https://orcid.org/0000-0002-9472-918X> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject pmwcat:PlantMetWiki ;
    schema:keywords "plantmetwiki" ;
    schema:target <https://plantmetwiki.bioinformatics.nl/sparql> ;
    snorql:alias "2.PlantMetWiki/Proteins_Names_andReference_forPathwayID.rq" ;
    prov:wasDerivedFrom <https://github.com/pathway-lod/SPARQLQueries/blob/12d919aa658aa4f7d9f35a457d684b9e17c5716c/2.PlantMetWiki/Proteins_Names_andReference_forPathwayID.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:select """# Named graphs used:
#   graph/pathways — pathway, protein, and reference triples
# Editable placeholder: change "/PC123_" to the internal pathway ID fragment of interest.
# Note: dc:identifier holds the internal sequential ID (e.g. "PC123") on the pathway IRI;
#       use FILTER(CONTAINS(STR(?pw), '/PC123_')) to target a specific pathway.

PREFIX wp:      <http://vocabularies.wikipathways.org/wp#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc:      <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT DISTINCT ?protein (STR(?proteinLabel) AS ?proteinName) ?publication
WHERE {
  GRAPH <http://rdf-plantmetwiki.bioinformatics.nl/graph/pathways> {
    ?pw rdf:type wp:Pathway ;
        dc:title ?title .
    FILTER(CONTAINS(STR(?pw), '/PC123_'))  # change pathway ID fragment here

    ?protein a wp:Protein ;
             rdfs:label ?proteinLabel ;
             dcterms:isPartOf ?pw .

    OPTIONAL { ?protein dcterms:references ?publication . }
  }
}
ORDER BY ?proteinName""" .
