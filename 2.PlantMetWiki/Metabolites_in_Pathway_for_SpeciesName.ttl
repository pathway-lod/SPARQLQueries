@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix pmwcat: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/category/> .
@prefix pmwq: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pmwq:PMWQ017 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "PMWQ017" ;
    rdfs:label "Metabolites in pathways of a species"@en ;
    rdfs:comment "Find metabolites in pathways that contain DataNodes annotated for a given species. Because metabolites themselves are rarely species-specific, this query finds all metabolites that co-occur in pathways with the requested species' genes/proteins."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2025-12-18"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:contributor <https://orcid.org/0000-0002-9472-918X> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject pmwcat:PlantMetWiki ;
    schema:keywords "plantmetwiki" ;
    schema:target <https://plantmetwiki.bioinformatics.nl/sparql> ;
    snorql:alias "2.PlantMetWiki/Metabolites_in_Pathway_for_SpeciesName.rq" ;
    prov:wasDerivedFrom <https://github.com/pathway-lod/SPARQLQueries/blob/8efab1d98ac2c492b8531868dbb3a1536f7ba54a/2.PlantMetWiki/Metabolites_in_Pathway_for_SpeciesName.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:select """# Edit the rdfs:label filter to change the species.

PREFIX wp:      <http://vocabularies.wikipathways.org/wp#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc:      <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT DISTINCT ?metabolite ?inchikey (STR(?titleLit) AS ?title)
WHERE {
  # Resolve species name
  GRAPH <http://rdf-plantmetwiki.bioinformatics.nl/graph/ncbitaxon> {
    ?taxon rdfs:label "Solanum tuberosum" .  # change species name here
  }
  # Find a DataNode annotated with that species — gives us the pathway
  GRAPH <http://rdf-plantmetwiki.bioinformatics.nl/graph/gpml-taxonomy-extra> {
    ?speciesNode wp:organism ?taxon .
  }
  GRAPH <http://rdf-plantmetwiki.bioinformatics.nl/graph/pathways> {
    ?speciesNode dcterms:isPartOf ?pw .
    # Find metabolites in the same pathway
    ?metabolite a wp:Metabolite ;
                dcterms:isPartOf ?pw .
    OPTIONAL { ?metabolite wp:bdbInChIKey ?inchikey . }
    ?pw dc:title ?titleLit .
  }
}
ORDER BY ASC(?metabolite)""" .
