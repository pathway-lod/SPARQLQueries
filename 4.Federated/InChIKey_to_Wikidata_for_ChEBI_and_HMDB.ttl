@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix pmwcat: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/category/> .
@prefix pmwq: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pmwq:PMWQ033 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "PMWQ033" ;
    rdfs:label "Wikidata, ChEBI and PubChem for metabolites, by InChIKey"@en ;
    rdfs:comment "Retrieve Wikidata entries, ChEBI IDs, and PubChem CIDs for metabolites in PlantMetWiki, matched via InChIKey (wdt:P235). Returns metabolites that occur in at most one pathway (rare/specialised compounds)."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2025-12-19"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:contributor <https://orcid.org/0000-0002-9472-918X> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject pmwcat:Federated ;
    schema:keywords "federated" ;
    schema:target <https://plantmetwiki.bioinformatics.nl/sparql> ;
    spex:federatesWith <https://query.wikidata.org/sparql> ;
    snorql:alias "4.Federated/InChIKey_to_Wikidata_for_ChEBI_and_HMDB.rq" ;
    prov:wasDerivedFrom <https://github.com/pathway-lod/SPARQLQueries/blob/7ea07a36e43adc4890b6081ff81c0e2b0ec1a221/4.Federated/InChIKey_to_Wikidata_for_ChEBI_and_HMDB.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:select """# Named graphs used:
#   graph/pathways — metabolite DataNodes with InChIKey identifiers
#
# Federation:
#   https://query.wikidata.org/sparql — chemical metadata via InChIKey
#
# Editable parameters:
#   HAVING clause: change <= 1 to restrict/expand pathway occurrence filter
#   LIMIT/OFFSET: paginate through results (100 items per page)

PREFIX dc:      <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp:      <http://vocabularies.wikipathways.org/wp#>
PREFIX wd:      <http://www.wikidata.org/entity/>
PREFIX wdt:     <http://www.wikidata.org/prop/direct/>
PREFIX p:       <http://www.wikidata.org/prop/>
PREFIX pq:      <http://www.wikidata.org/prop/qualifier/>

SELECT DISTINCT ?inchikey ?nPWOcurrences ?wd ?wdLabel ?chebi ?pubchem
WHERE {
  {
    SELECT ?inchikey (COUNT(DISTINCT ?pwID) AS ?nPWOcurrences)
    WHERE {
      GRAPH <http://rdf-plantmetwiki.bioinformatics.nl/graph/pathways> {
        ?metabolite a wp:Metabolite ;
                    dcterms:isPartOf ?pw ;
                    dc:source "InChIKey" ;
                    dcterms:identifier ?inchikey .
        ?pw a wp:Pathway ;
            dc:identifier ?pwID .
      }
    }
    GROUP BY ?inchikey
    HAVING (COUNT(DISTINCT ?pwID) <= 1)   # specialised metabolites (change limit here)
    LIMIT 100                              # page size
    OFFSET 0                              # increment by 100 for next page
  }

  # Federated: enrich with Wikidata chemical metadata via InChIKey
  SERVICE <https://query.wikidata.org/sparql> {
    ?wd wdt:P235 ?inchikey .
    OPTIONAL { ?wd rdfs:label ?wdLabel . FILTER(LANG(?wdLabel) = "en") }
    OPTIONAL {
      ?wd wdt:P683 ?chebi ;
          p:P683 ?internalID .
      ?internalID pq:P4390 wd:Q39893449 .  # ChEBI exact match only
    }
    OPTIONAL { ?wd wdt:P662 ?pubchem . }
  }
}
ORDER BY DESC(?nPWOcurrences)""" .
