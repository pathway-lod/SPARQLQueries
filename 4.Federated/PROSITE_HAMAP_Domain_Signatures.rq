# title: PROSITE / HAMAP Domain Signatures
# category: Gene Function
# description: For a pathway's UniProt-accession enzymes, federates to UniProt's
#   own SPARQL endpoint to list the PROSITE pattern/profile and HAMAP family
#   signature identifiers (rdfs:seeAlso) attached to each protein.
#   LIMITATION (checked live, both still true as of writing): neither PROSITE
#   nor HAMAP currently exposes a reachable public SPARQL endpoint of their own
#   (purl.expasy.org/prosite/signature/<id> resolves to an HTML page only;
#   HAMAP's documented endpoint, hamap.expasy.org/sparql[/sparql], 404s on every
#   URL pattern tried), so this query can only surface the bare signature id via
#   UniProt — not the signature's name/description, which would need a second
#   federated hop that isn't available right now.
# param: pathwayId | string | PC302 | Pathway ID
#
# Pre-filled below with the example pathway (PC302, phytosterol biosynthesis)
# so this runs as-is when pasted directly into the SPARQL Explorer. Edit:
# replace "PC302" with any other PlantMetWiki pathway ID to query it instead.

PREFIX wp:      <http://vocabularies.wikipathways.org/wp#>
PREFIX dc:      <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?title ?protein ?signature
WHERE {
  GRAPH <http://rdf-plantmetwiki.bioinformatics.nl/graph/pathways> {
    ?pw a wp:Pathway ; dcterms:identifier "PC302" ; dc:title ?title .
    ?cat a wp:Catalysis ; wp:source ?protein ; wp:target ?conv .
    ?conv a wp:Conversion ; dcterms:isPartOf ?pw .
    FILTER(STRSTARTS(STR(?protein), "https://identifiers.org/uniprot/"))
  }
  BIND(IRI(CONCAT("http://purl.uniprot.org/uniprot/", STRAFTER(STR(?protein), "/uniprot/"))) AS ?uniprotIri)

  SERVICE <https://sparql.uniprot.org/sparql> {
    ?uniprotIri rdfs:seeAlso ?signature .
    FILTER(STRSTARTS(STR(?signature), "https://purl.expasy.org/prosite/") || STRSTARTS(STR(?signature), "https://purl.expasy.org/hamap/"))
  }
}
ORDER BY ?protein
