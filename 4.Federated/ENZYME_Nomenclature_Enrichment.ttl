@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix pmwcat: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/category/> .
@prefix pmwq: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pmwq:PMWQ039 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "PMWQ039" ;
    rdfs:label "ENZYME Nomenclature Enrichment"@en ;
    rdfs:comment "For a pathway's reactions that carry an \"Enzyme Nomenclature\" (EC number) cross-reference, federates to UniProt's own SPARQL endpoint (sparql.uniprot.org) — which also serves the Expasy ENZYME database in RDF — to retrieve the enzyme's official name, synonyms and curator comments (catalytic notes, substrate range, species specificity)."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-11-22"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0002-9472-918X> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject pmwcat:Federated ;
    schema:keywords "federated" ;
    schema:target <https://plantmetwiki.bioinformatics.nl/sparql> ;
    spex:federatesWith <https://sparql.uniprot.org/sparql> ;
    snorql:alias "4.Federated/ENZYME_Nomenclature_Enrichment.rq" ;
    prov:wasDerivedFrom <https://github.com/pathway-lod/SPARQLQueries/blob/6041d54d281843897808cba86a2ffe608d153f23/4.Federated/ENZYME_Nomenclature_Enrichment.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [
        a sh:Parameter ;
        sh:path param:pathwayId ;
        sh:name "Pathway ID" ;
        sh:defaultValue "PC302" ;
        sh:datatype xsd:string ;
        snorql:autocomplete "pathway" ;
        sh:order 1
    ] ;
    sh:select """PREFIX wp:      <http://vocabularies.wikipathways.org/wp#>
PREFIX gpml:    <http://vocabularies.wikipathways.org/gpml#>
PREFIX dc:      <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?title ?ecNumber ?prefLabel ?comment
WHERE {
  GRAPH <http://rdf-plantmetwiki.bioinformatics.nl/graph/pathways> {
    VALUES ?pathwayId { "PC302" }
    ?pw a wp:Pathway ; dcterms:identifier ?pathwayId ; dc:title ?title .
    ?conv a wp:Conversion ; dcterms:isPartOf ?pw ; wp:isAbout ?interaction .
    ?interaction gpml:xrefDataSource "Enzyme Nomenclature" ; gpml:xrefId ?xrefId .
    BIND(STRAFTER(?xrefId, "EC-") AS ?ecNumber)
  }
  BIND(IRI(CONCAT("http://purl.uniprot.org/enzyme/", ?ecNumber)) AS ?enzymeIri)

  SERVICE <https://sparql.uniprot.org/sparql> {
    ?enzymeIri skos:prefLabel ?prefLabel .
    OPTIONAL { ?enzymeIri rdfs:comment ?comment }
  }
}
ORDER BY ?ecNumber""" .
