@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix pmwcat: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/category/> .
@prefix pmwq: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pmwq:PMWQ041 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "PMWQ041" ;
    rdfs:label "PROSITE / HAMAP Domain Signatures"@en ;
    rdfs:comment "For a pathway's UniProt-accession enzymes, federates to UniProt's own SPARQL endpoint to list the PROSITE pattern/profile and HAMAP family signature identifiers (rdfs:seeAlso) attached to each protein. LIMITATION (checked live, both still true as of writing): neither PROSITE nor HAMAP currently exposes a reachable public SPARQL endpoint of their own (purl.expasy.org/prosite/signature/<id> resolves to an HTML page only; HAMAP's documented endpoint, hamap.expasy.org/sparql[/sparql], 404s on every URL pattern tried), so this query can only surface the bare signature id via UniProt — not the signature's name/description, which would need a second federated hop that isn't available right now."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-11-22"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0002-9472-918X> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject pmwcat:Federated ;
    schema:keywords "federated" ;
    schema:target <https://plantmetwiki.bioinformatics.nl/sparql> ;
    spex:federatesWith <https://sparql.uniprot.org/sparql> ;
    snorql:alias "4.Federated/PROSITE_HAMAP_Domain_Signatures.rq" ;
    prov:wasDerivedFrom <https://github.com/pathway-lod/SPARQLQueries/blob/67d61b5e8427f7511c3af8e1d99c7b1534236391/4.Federated/PROSITE_HAMAP_Domain_Signatures.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [
        a sh:Parameter ;
        sh:path param:pathwayId ;
        sh:name "Pathway ID" ;
        sh:defaultValue "PC302" ;
        sh:datatype xsd:string ;
        snorql:autocomplete "pathway" ;
        sh:order 1
    ] ;
    sh:select """PREFIX wp:      <http://vocabularies.wikipathways.org/wp#>
PREFIX dc:      <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?title ?protein ?signature
WHERE {
  GRAPH <http://rdf-plantmetwiki.bioinformatics.nl/graph/pathways> {
    VALUES ?pathwayId { "PC302" }
    ?pw a wp:Pathway ; dcterms:identifier ?pathwayId ; dc:title ?title .
    ?cat a wp:Catalysis ; wp:source ?protein ; wp:target ?conv .
    ?conv a wp:Conversion ; dcterms:isPartOf ?pw .
    FILTER(STRSTARTS(STR(?protein), "https://identifiers.org/uniprot/"))
  }
  BIND(IRI(CONCAT("http://purl.uniprot.org/uniprot/", STRAFTER(STR(?protein), "/uniprot/"))) AS ?uniprotIri)

  SERVICE <https://sparql.uniprot.org/sparql> {
    ?uniprotIri rdfs:seeAlso ?signature .
    FILTER(STRSTARTS(STR(?signature), "https://purl.expasy.org/prosite/") || STRSTARTS(STR(?signature), "https://purl.expasy.org/hamap/"))
  }
}
ORDER BY ?protein""" .
