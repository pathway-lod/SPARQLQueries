# title: ENZYME Nomenclature Enrichment
# category: Gene Function
# description: For a pathway's reactions that carry an "Enzyme Nomenclature" (EC
#   number) cross-reference, federates to UniProt's own SPARQL endpoint
#   (sparql.uniprot.org) — which also serves the Expasy ENZYME database in RDF —
#   to retrieve the enzyme's official name, synonyms and curator comments
#   (catalytic notes, substrate range, species specificity).
# param: pathwayId | string | PC302 | Pathway ID
#
# Pre-filled below with the example pathway (PC302, phytosterol biosynthesis)
# so this runs as-is when pasted directly into the SPARQL Explorer. Edit:
# replace "PC302" with any other PlantMetWiki pathway ID to query it instead.
#
# Join path: PlantMetWiki stores EC numbers as a plain gpml:xrefId, e.g.
# "EC-2.1.1.41". Strip the "EC-" prefix and rebuild the ENZYME/UniProt IRI
# (http://purl.uniprot.org/enzyme/<ec>) to federate on skos:prefLabel.

PREFIX wp:      <http://vocabularies.wikipathways.org/wp#>
PREFIX gpml:    <http://vocabularies.wikipathways.org/gpml#>
PREFIX dc:      <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?title ?ecNumber ?prefLabel ?comment
WHERE {
  GRAPH <http://rdf-plantmetwiki.bioinformatics.nl/graph/pathways> {
    ?pw a wp:Pathway ; dcterms:identifier "PC302" ; dc:title ?title .
    ?conv a wp:Conversion ; dcterms:isPartOf ?pw ; wp:isAbout ?interaction .
    ?interaction gpml:xrefDataSource "Enzyme Nomenclature" ; gpml:xrefId ?xrefId .
    BIND(STRAFTER(?xrefId, "EC-") AS ?ecNumber)
  }
  BIND(IRI(CONCAT("http://purl.uniprot.org/enzyme/", ?ecNumber)) AS ?enzymeIri)

  SERVICE <https://sparql.uniprot.org/sparql> {
    ?enzymeIri skos:prefLabel ?prefLabel .
    OPTIONAL { ?enzymeIri rdfs:comment ?comment }
  }
}
ORDER BY ?ecNumber
