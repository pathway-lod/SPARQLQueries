@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix pmwcat: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/category/> .
@prefix pmwq: <https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pmwq:PMWQ037 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "PMWQ037" ;
    rdfs:label "Rhea Reaction Enrichment"@en ;
    rdfs:comment "For a pathway's reactions that carry a Rhea cross-reference, federates to the Rhea SPARQL endpoint (sparql.rhea-db.org) to retrieve the full reaction equation and every participating ChEBI compound. Returns one row per (reaction, Rhea participant) to avoid GROUP_CONCAT overflow."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-11-22"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0002-9472-918X> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject pmwcat:Federated ;
    schema:keywords "federated" ;
    schema:target <https://plantmetwiki.bioinformatics.nl/sparql> ;
    spex:federatesWith <https://sparql.rhea-db.org/sparql> ;
    snorql:alias "4.Federated/Rhea_Reaction_Enrichment.rq" ;
    prov:wasDerivedFrom <https://github.com/pathway-lod/SPARQLQueries/blob/874874b311aa093a6c7e68cdb7354d90d813ba49/4.Federated/Rhea_Reaction_Enrichment.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [
        a sh:Parameter ;
        sh:path param:pathwayId ;
        sh:name "Pathway ID" ;
        sh:defaultValue "PC302" ;
        sh:datatype xsd:string ;
        snorql:autocomplete "pathway" ;
        sh:order 1
    ] ;
    sh:select """PREFIX wp:      <http://vocabularies.wikipathways.org/wp#>
PREFIX gpml:    <http://vocabularies.wikipathways.org/gpml#>
PREFIX dc:      <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rh:      <http://rdf.rhea-db.org/>

SELECT DISTINCT ?title ?rheaAccession ?equation ?chebiName ?chebi
WHERE {
  GRAPH <http://rdf-plantmetwiki.bioinformatics.nl/graph/pathways> {
    VALUES ?pathwayId { "PC302" }
    ?pw a wp:Pathway ; dcterms:identifier ?pathwayId ; dc:title ?title .
    ?conv a wp:Conversion ; dcterms:isPartOf ?pw ; wp:isAbout ?interaction .
    ?interaction gpml:xrefDataSource "Rhea" ; gpml:xrefId ?rheaId .
  }
  BIND(IRI(CONCAT("http://rdf.rhea-db.org/", ?rheaId)) AS ?reaction)

  SERVICE <https://sparql.rhea-db.org/sparql> {
    ?reaction rh:accession ?rheaAccession ;
              rh:equation ?equation ;
              rh:side ?side .
    ?side rh:contains ?participant .
    ?participant rh:compound ?compound .
    ?compound rh:name ?chebiName ;
              rh:chebi ?chebi .
  }
}
ORDER BY ?rheaAccession ?chebiName""" .
