PREFIX ncbi:    <http://purl.obolibrary.org/obo/NCBITaxon_>
PREFIX ro:		<http://purl.obolibrary.org/obo/RO_>

SELECT DISTINCT ?type
WHERE { ?s a ?type . } # Find all entity types in our database to help build your queries!
