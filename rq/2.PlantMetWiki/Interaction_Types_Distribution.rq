# title: Number of interactions per type
# category: PlantMetWiki
# description: Count the number of interactions of each wp:Interaction subtype across the whole knowledge base: Catalysis, Conversion, TranscriptionTranslation, Inhibition, Stimulation, Binding and ComplexBinding.
#
# PMWQ015 version 1.0.0, https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/PMWQ015
# Generated from 2.PlantMetWiki/Interaction_Types_Distribution.ttl in pathway-lod/SPARQLQueries at d1bc97e6f915; edit the .ttl file, not this one.

#                   Stimulation, Binding, ComplexBinding.
#
# Named graphs used:
#   graph/pathways — all interaction triples

PREFIX wp:      <http://vocabularies.wikipathways.org/wp#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?interactionType (COUNT(DISTINCT ?interaction) AS ?nInteractions)
WHERE {
  GRAPH <http://rdf-plantmetwiki.bioinformatics.nl/graph/pathways> {
    ?interaction rdf:type ?interactionType .
    VALUES ?interactionType {
      wp:Catalysis
      wp:Conversion
      wp:TranscriptionTranslation
      wp:Inhibition
      wp:Stimulation
      wp:Binding
      wp:ComplexBinding
    }
  }
}
GROUP BY ?interactionType
ORDER BY DESC(?nInteractions)
