# title: ENZYME Nomenclature Enrichment
# category: Federated
# description: For a pathway's reactions that carry an "Enzyme Nomenclature" (EC number) cross-reference, federates to UniProt's own SPARQL endpoint (sparql.uniprot.org) — which also serves the Expasy ENZYME database in RDF — to retrieve the enzyme's official name, synonyms and curator comments (catalytic notes, substrate range, species specificity).
# param: pathwayId|autocomplete:pathway|PC302|Pathway ID
#
# PMWQ039 version 1.0.0, https://plantmetwiki.bioinformatics.nl/.well-known/sparql-examples/PMWQ039
# Generated from 4.Federated/ENZYME_Nomenclature_Enrichment.ttl in pathway-lod/SPARQLQueries at d1bc97e6f915; edit the .ttl file, not this one.

PREFIX wp:      <http://vocabularies.wikipathways.org/wp#>
PREFIX gpml:    <http://vocabularies.wikipathways.org/gpml#>
PREFIX dc:      <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?title ?ecNumber ?prefLabel ?comment
WHERE {
  GRAPH <http://rdf-plantmetwiki.bioinformatics.nl/graph/pathways> {
    VALUES ?pathwayId { "{{pathwayId}}" }
    ?pw a wp:Pathway ; dcterms:identifier ?pathwayId ; dc:title ?title .
    ?conv a wp:Conversion ; dcterms:isPartOf ?pw ; wp:isAbout ?interaction .
    ?interaction gpml:xrefDataSource "Enzyme Nomenclature" ; gpml:xrefId ?xrefId .
    BIND(STRAFTER(?xrefId, "EC-") AS ?ecNumber)
  }
  BIND(IRI(CONCAT("http://purl.uniprot.org/enzyme/", ?ecNumber)) AS ?enzymeIri)

  SERVICE <https://sparql.uniprot.org/sparql> {
    ?enzymeIri skos:prefLabel ?prefLabel .
    OPTIONAL { ?enzymeIri rdfs:comment ?comment }
  }
}
ORDER BY ?ecNumber
